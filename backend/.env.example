# Django secret key (generate your own for production)
SECRET_KEY=django-insecure-change-this-key-in-production
DEBUG=True

# Set to "mysql" to use MySQL, or "sqlite" to use SQLite (default, easiest for local testing)
DB_ENGINE=sqlite

# MySQL settings (used only when DB_ENGINE=mysql)
DB_NAME=expense_tracker
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# Comma separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
